{
  "name": "dsh-model-kit",
  "version": "0.1.1",
  "description": "Model parameter editing, imports, and native USD/CNY pricing for DeepSeek Harness.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerseusNana7mi/dsh-model-kit.git"
  },
  "homepage": "https://github.com/PerseusNana7mi/dsh-model-kit#readme",
  "bugs": {
    "url": "https://github.com/PerseusNana7mi/dsh-model-kit/issues"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/core/catalog.d.ts",
      "import": "./lib/core/catalog.js"
    },
    "./client": {
      "types": "./lib/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs/README.md",
    "docs/development.md",
    "docs/editor.md",
    "docs/cost-integration.md",
    "docs/pi-web-workflow.md",
    "docs/pricing-sources.md",
    "docs/references.md",
    "docs/settings.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "models-dev"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-client.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "prepack": "npm run build",
    "test:ui": "node scripts/test-ui.mjs && node scripts/test-ui-regressions.mjs && node scripts/test-select-layout.mjs && node scripts/test-settings-page.mjs && node scripts/test-editor-safety.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-api-remotes": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-settings-models": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "@deepseek-ai/dsh-typert-registry": "^0.2.0-rc.2 || ^0.2.1-alpha.1",
    "react": "^18.3.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.0-rc.2 || ^0.2.1-alpha.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-config-editor": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~5.9.3"
  }
}
